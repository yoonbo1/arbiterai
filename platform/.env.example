# Copy to .env and replace every placeholder (e.g. `openssl rand -hex 24`).
# .env is git-ignored; never commit real values.

# ---- Postgres ----
# Owner/superuser role: used by the container init scripts and (optionally) migrations
# or the LangGraph postgres checkpointer. The application does NOT connect as this role.
PG_USER=hipaa
PG_PASSWORD=change-me
PG_DB=hipaa
# Host port the compose Postgres is published on (127.0.0.1 only). Change if the machine
# already runs a Postgres on 5432 (Homebrew does); eval/run_eval.py's DATABASE_URL uses it.
PG_HOST_PORT=5432
# Application role. Subject to row-level security (the owner role bypasses RLS, which is
# why the app must not use it). db/02_app_role.sh sets this password on first init.
PG_APP_USER=app_rw
PG_APP_PASSWORD=change-me-app
# Gateway and worker connect as app_rw so RLS applies to every query.
DATABASE_URL=postgresql://app_rw:change-me-app@postgres:5432/hipaa
# Owner URL; only read when CHECKPOINTER=postgres (checkpoint tables need CREATE).
DATABASE_ADMIN_URL=postgresql://hipaa:change-me@postgres:5432/hipaa

# ---- Redis ----
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0

# ---- Models: every endpoint must be local or BAA-covered ----
# GPU box (docker compose --profile gpu [--profile vlm]): the vLLM services below.
#   SMALL_MODEL_URL=http://vllm-small:8000/v1   SMALL_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
#   VLM_URL=http://vllm-vlm:8000/v1             VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# Apple Silicon / no GPU: Ollama on the host (`OLLAMA_HOST=0.0.0.0:11434 ollama serve`,
# `ollama pull qwen2.5:7b-instruct`); containers reach it via host.docker.internal.
SMALL_MODEL_URL=http://host.docker.internal:11434/v1
SMALL_MODEL=qwen2.5:7b-instruct
# Escalation tier. If unset, falls back to the small tier (not the VLM).
LARGE_MODEL_URL=http://host.docker.internal:11434/v1
LARGE_MODEL=qwen2.5:7b-instruct
# Vision model for scanned pages. Leave EMPTY when there is none: pages that the router
# would send to the VLM then fall back to Tesseract OCR (flagged vlm_wanted in the logs).
VLM_URL=
VLM_MODEL=
# HTTP timeout for one model call, seconds (Ollama on a laptop is slower than vLLM).
LLM_TIMEOUT_S=300
# Embeddings service: POST /embed {"inputs": [...], "truncate": true} -> [[384 floats], ...]
EMBED_URL=http://embeddings:80
EMBED_MODEL=BAAI/bge-small-en-v1.5

# ---- Gateway ----
# Pepper mixed into API key hashes; rotate = invalidate all keys, so store in a secrets manager.
API_KEY_PEPPER=change-me-long-random
ADMIN_TOKEN=change-me-admin

# ---- Worker ----
# Key-encryption key every tenant key is derived from (worker/tenant_keys.py, shared by the worker and
# the gateway): encrypts the reversible PHI map, job requests and results, and patient external ids
# (pgp_sym_encrypt), and keys the patient-id lookup hash. Prod: per-tenant DEKs from KMS/Vault.
TENANT_KEK=change-me-kek
# LangGraph checkpointer: none (default) | memory | postgres.
#   none:     graphs run without checkpoints; a crashed job is retried from the start (safe).
#   memory:   in-process only; grows without bound in a long-running worker (tests only).
#   postgres: persists graph state, which contains PRE-de-identification text and the
#             plaintext phi_map, outside RLS and unencrypted. Do NOT use with real data
#             until that state is encrypted and tenant-scoped. Uses DATABASE_ADMIN_URL.
CHECKPOINTER=none
# spaCy model Presidio uses inside the worker (must match the image's build ARG SPACY_MODEL).
# en_core_web_lg is Presidio's default; en_core_web_sm builds faster for dev (lower NER recall).
SPACY_MODEL=en_core_web_lg
# Only files under this directory may be ingested (storage_uri is client input).
DATA_ROOT=/data
# Redis Streams recovery: after this many deliveries a job is marked failed and acked;
# messages idle longer than WORKER_CLAIM_IDLE_MS are reclaimed from dead workers.
WORKER_MAX_DELIVERIES=3
WORKER_CLAIM_IDLE_MS=300000
# 1 = print full Python tracebacks for failed jobs. Exception messages can echo document
# text, so leave 0 anywhere real data could appear; job logs otherwise carry no PHI.
WORKER_DEBUG_TRACEBACKS=0

# ---- Telemetry ----
# Never enable cloud tracing with PHI. Self-host Langfuse/LangSmith or leave unset.
LANGCHAIN_TRACING_V2=false


# ---- Clinical annotation (worker/annotate.py) ----
# 1 = run the annotate node (medspaCy sections + ConText, Med7 and bc5cdr NER, regex rules) and
# write clinical_facts; 0 = skip it (empty fact lists; the rest of ingestion is unchanged).
ANNOTATE=1
# 1 = also send the medication/allergy/diagnosis/lab/plan section bodies (de-identified) to the
# small local model for JSON-schema attribute filling. Costs 25-60 s per document on a laptop and
# never decides assertion, so it is off by default.
ANNOTATE_LLM=0
