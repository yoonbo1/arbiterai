# ---- secrets: never commit ----
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---- data: synthetic docs, PDFs, DB dumps, model caches ----
data/
platform/data/
*.dump
*.sql.gz

# ---- python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# ---- site build output (regenerated by `make site` / python3 build.py) ----
site/public/

# ---- source archives and scratch ----
/*.zip
/scratch/
*.log

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
node_modules/
